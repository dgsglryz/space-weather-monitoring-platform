SECRET_KEY=django-insecure-space-weather-demo-key
DEBUG=1
DJANGO_ENV=development
ALLOWED_HOSTS=*

POSTGRES_DB=space
POSTGRES_USER=space
POSTGRES_PASSWORD=space
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_URL=redis://redis:6379/2
REDIS_HOST=redis
REDIS_PORT=6379

OWM_API_KEY=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@example.com
ALERT_NOTIFICATION_EMAIL=
EMAIL_TIMEOUT=10
ALERT_EMAIL_MAX_ATTEMPTS=2
ALERT_EMAIL_RETRY_BACKOFF_SECONDS=2.0

WEATHER_CACHE_SECONDS=30
DASHBOARD_REFRESH_MAX_AGE_SECONDS=2700
DASHBOARD_REFRESH_COOLDOWN_SECONDS=300