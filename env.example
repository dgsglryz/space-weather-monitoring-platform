SECRET_KEY=replace-with-strong-secret
DEBUG=0
DJANGO_ENV=production
ALLOWED_HOSTS=space-weather.example.com

POSTGRES_DB=space_weather
POSTGRES_USER=space_weather
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_URL=redis://redis:6379/2
REDIS_HOST=redis
REDIS_PORT=6379

OWM_API_KEY=replace-with-openweathermap-key

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=alerts@example.com
EMAIL_HOST_PASSWORD=replace-with-email-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=alerts@example.com
ALERT_NOTIFICATION_EMAIL=alerts@example.com
EMAIL_TIMEOUT=10
ALERT_EMAIL_MAX_ATTEMPTS=2
ALERT_EMAIL_RETRY_BACKOFF_SECONDS=2.0

WEATHER_CACHE_SECONDS=30
DASHBOARD_REFRESH_MAX_AGE_SECONDS=2700
DASHBOARD_REFRESH_COOLDOWN_SECONDS=300

